# ==========================================
# AI Academic Assistant - Environment Configuration
# ==========================================

# Application Port
PORT=8000

# Security & Tokens
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL=sqlite:///./academic_assistant.db
# DATABASE_URL=postgresql://user:password@host:5432/academic_assistant

# AI LLM Provider Keys
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# File Storage
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# Frontend Production API URL (used when deploying frontend independently)
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api
