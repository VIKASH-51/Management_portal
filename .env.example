# AI Academic Assistant Environment Configuration

# Backend Settings
PROJECT_NAME="AI Academic Assistant"
SECRET_KEY="super-secret-production-jwt-key-please-change-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite by default, or PostgreSQL)
DATABASE_URL="sqlite:///./academic_assistant.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/academic_assistant"

# AI Provider API Keys (Configure your preferred provider)
DEFAULT_AI_PROVIDER="gemini"
GEMINI_API_KEY="your-google-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Upload and Export Storage
UPLOAD_DIR="./uploads"
EXPORT_DIR="./exports"
